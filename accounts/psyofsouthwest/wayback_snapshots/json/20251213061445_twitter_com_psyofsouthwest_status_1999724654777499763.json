                "expanded_url": "https://globalleadernews.com/%e4%b9%a0%e8%bf%91%e5%b9%b3%e4%bf%a1%e7%94%a8%e7%a0%b4%e4%ba%a7%ef%bc%8c%e5%ae%98%e5%aa%92%e5%a4%84%e5%a4%84%e7%bf%bb%e8%bd%a6/",
