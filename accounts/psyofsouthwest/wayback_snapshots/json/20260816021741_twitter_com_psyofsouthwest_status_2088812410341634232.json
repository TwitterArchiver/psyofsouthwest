        "note_tweet": {
          "entities": {
            "urls": [
              {
                "display_url": "security-portal.cyber.go.jp/guidance/cyber…",
                "end": 791,
                "expanded_url": "https://security-portal.cyber.go.jp/guidance/cybersecurity9principles.html",
                "start": 768,
